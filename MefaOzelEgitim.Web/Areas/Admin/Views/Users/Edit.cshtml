@model MefaOzelEgitim.Web.Models.UserEditViewModel

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
            <!-- Başlık ve İkon Alanı -->
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                <div class="bg-primary text-white rounded-4 d-flex align-items-center justify-content-center me-3 shadow-sm"
                     style="width: 55px; height: 55px; min-width: 55px;">
                    <i class="fa-solid fa-user-pen fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-1">Kullanıcı Düzenle</h3>
                    <p class="text-muted small mb-0">Kullanıcı hesap bilgilerini ve kişisel detaylarını güncelleyin.</p>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                <!-- Sadece hata olduğunda kırmızı kutu görünür (Sayfa açılışında boş şerit çıkmaz) -->
                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div asp-validation-summary="All" class="alert alert-danger rounded-3 small mb-4" role="alert"></div>
                }

                <!-- Hangi kullanıcının güncellendiğini belirten gizli ID alanı -->
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label fw-semibold text-secondary">Ad</label>
                        <input asp-for="FirstName" class="form-control rounded-3 py-2" placeholder="Örn: Ahmet" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label fw-semibold text-secondary">Soyad</label>
                        <input asp-for="LastName" class="form-control rounded-3 py-2" placeholder="Örn: Yılmaz" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="UserName" class="form-label fw-semibold text-secondary">Kullanıcı Adı
                            (Username)</label>
                            <input asp-for="UserName" class="form-control rounded-3 py-2" placeholder="Kullanıcı adı..." />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary">E-Posta Adresi</label>
                            <input asp-for="Email" class="form-control rounded-3 py-2" placeholder="ornek@mail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold text-secondary">Telefon Numarası</label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3 py-2" placeholder="05xx xxx xx xx" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2">
                        <a asp-action="Index" class="btn btn-light px-4 rounded-3 fw-semibold text-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary px-5 rounded-3 fw-semibold shadow-sm">
                            <i class="fa-solid fa-save me-2"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }