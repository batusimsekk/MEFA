@model IEnumerable<MefaOzelEgitim.Domain.Entities.Announcement>

@{
    ViewData["Title"] = "Duyuru Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Duyurular</h2>
        <p class="text-muted small mb-0">Sistemde yayınlanan duyuruları buradan yönetebilirsiniz.</p>
    </div>
    <a href="/Admin/Announcements/Create" class="btn btn-primary px-4 rounded-pill fw-semibold shadow-sm">
        <i class="fa-solid fa-plus me-2"></i> Yeni Duyuru Ekle
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-secondary">
                    <tr>
                        <th class="ps-4">Başlık</th>
                        <th>İçerik</th>
                        <th>Tarih</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">
                                    @item.Title
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @if (!string.IsNullOrEmpty(item.Content) && item.Content.Length > 60)
                                        {
                                            @($"{item.Content.Substring(0, 60)}...")
                                        }
                                        else
                                        {
                                            @item.Content
                                        }
                                    </span>
                                </td>
                                <td>
                                    <span class="text-secondary small fw-medium">
                                        @item.CreatedDate.ToString("dd.MM.yyyy")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/Admin/Announcements/Edit/@item.Id"
                                       class="btn btn-sm btn-light text-primary me-1 rounded-3" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <!-- SweetAlert ile tetiklenecek Silme Formu -->
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                          class="d-inline delete-form">
                                        <button type="button" class="btn btn-sm btn-light text-danger rounded-3 delete-btn"
                                                title="Sil">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-info-circle me-1"></i> Henüz kayıtlı duyuru eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Tüm silme butonlarına tıklandığında çalışır
            document.querySelectorAll('.delete-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const form = this.closest('form');

                    Swal.fire({
                        title: 'Emin misiniz?',
                        text: "Bu duyuru sistemden kalıcı olarak silinecektir!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545', // Kırmızı (Bootstrap Danger)
                        cancelButtonColor: '#6c757d',  // Gri (Bootstrap Secondary)
                        confirmButtonText: '<i class="fa-solid fa-trash-can me-1"></i> Evet, Sil!',
                        cancelButtonText: 'İptal',
                        customClass: {
                            popup: 'rounded-4 shadow-sm border-0',
                            confirmButton: 'px-4 py-2 rounded-3 fw-semibold',
                            cancelButton: 'px-4 py-2 rounded-3 fw-semibold'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit(); // Onay verilirse formu gönderir
                        }
                    });
                });
            });
        });
    </script>
}