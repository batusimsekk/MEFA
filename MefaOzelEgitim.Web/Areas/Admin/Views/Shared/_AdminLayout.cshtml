@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MEFA Yönetim Paneli</title>

    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- FontAwesome Icon Seti -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- Admin Özel CSS Dosyası -->
    <link rel="stylesheet" href="~/css/admin-layout.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- Sidebar / Sol Menü -->
    <nav class="sidebar">
        <a href="/Admin/Dashboard" class="sidebar-brand">
            <i class="fa-solid fa-shield-halved text-primary me-2 fs-4"></i> MEFA Admin
        </a>
        <ul class="sidebar-menu">
            <li>
                <a href="/Admin/Dashboard"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Dashboard") ? "active" : "")">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>
            </li>
            <li>
                <a href="/Admin/Appointments"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Appointments") ? "active" : "")">
                    <i class="fa-solid fa-calendar-check"></i> Randevu Yönetimi
                </a>
            </li>
            <li>
                <a href="/Admin/Services"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Services") ? "active" : "")">
                    <i class="fa-solid fa-graduation-cap"></i> Eğitimler / Hizmetler
                </a>
            </li>
            <li>
                <a href="/Admin/Staff"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Staff") ? "active" : "")">
                    <i class="fa-solid fa-user-doctor"></i> Uzman Kadro
                </a>
            </li>
            <li>
                <a href="/Admin/Announcements"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Announcements") ? "active" : "")">
                    <i class="fa-solid fa-bullhorn"></i> Duyurular
                </a>
            </li>
            <li>
                <a href="/Admin/Users"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Users") ? "active" : "")">
                    <i class="fa-solid fa-users"></i> Kullanıcılar
                </a>
            </li>
            <!-- İletişim Mesajları (ViewComponent Entegre Edildi) -->
            <li>
                <a href="/Admin/Messages"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Messages") ? "active" : "") d-flex justify-content-between align-items-center">
                   <div>
                       <i class="fa-solid fa-envelope"></i> İletişim Mesajları
                   </div>
                   @await Component.InvokeAsync("UnreadMessagesBadge")
                </a>
            </li>
            <hr class="border-secondary opacity-25 mx-3 my-3">
            <li>
                <a href="/" target="_blank">
                    <i class="fa-solid fa-globe"></i> Siteye Git
                </a>
            </li>
        </ul>
    </nav>

    <!-- Ana İçerik ve Üst Bar -->
    <div class="main-content">
        <!-- Topbar -->
        <header class="admin-topbar">
            <div class="fw-semibold text-secondary">
                <i class="fa-solid fa-house-chimney me-1"></i> Yönetim Paneli
            </div>
            
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle"
                   data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 shadow-sm"
                         style="width: 38px; height: 38px;">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>
                    <span class="fw-semibold">Admin</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                    <li>
                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="px-0 m-0">
                            <button type="submit" class="dropdown-item py-2 text-danger fw-semibold">
                                <i class="fa-solid fa-right-from-bracket me-2"></i>Çıkış Yap
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        <!-- Sayfa İçeriği -->
        <main class="content-body">
            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>