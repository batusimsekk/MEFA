@model IEnumerable<MefaOzelEgitim.Domain.Entities.Appointment>

@{
    ViewData["Title"] = "Randevu Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var totalCount = Model.Count();
    var pendingCount = Model.Count(x => x.Status == "Beklemede");
    var approvedCount = Model.Count(x => x.Status == "Onaylandı");
    var cancelledCount = Model.Count(x => x.Status == "İptal edildi.");
}

<div class="container-fluid py-4">
    <!-- Başlık Alanı -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-1">Randevu Yönetimi</h2>
            <p class="text-muted small mb-0">Web sitesi üzerinden gelen ücretsiz değerlendirme ve görüşme taleplerini yönetin.</p>
        </div>
    </div>

    <!-- İstatistik Kartları -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-dark border-start border-primary border-4 text-white" style="background-color: #111827 !important; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="d-block text-muted small fw-semibold">TOPLAM TALEP</span>
                        <h3 class="fw-bold text-white mb-0 mt-1">@totalCount</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-calendar-days fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-dark border-start border-warning border-4 text-white" style="background-color: #111827 !important; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="d-block text-muted small fw-semibold">BEKLEYENLER</span>
                        <h3 class="fw-bold text-white mb-0 mt-1">@pendingCount</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-clock-rotate-left fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-dark border-start border-success border-4 text-white" style="background-color: #111827 !important; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="d-block text-muted small fw-semibold">ONAYLANANLAR</span>
                        <h3 class="fw-bold text-white mb-0 mt-1">@approvedCount</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-circle-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-dark border-start border-danger border-4 text-white" style="background-color: #111827 !important; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="d-block text-muted small fw-semibold">İPTAL EDİLENLER</span>
                        <h3 class="fw-bold text-white mb-0 mt-1">@cancelledCount</h3>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-ban fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bildirim Mesajları -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="fa-solid fa-circle-info me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Randevu Tablosu Kartı -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background-color: #111827 !important; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
        <div class="card-header bg-transparent py-3 px-4 border-bottom border-secondary border-opacity-25">
            <h5 class="fw-bold text-white mb-0">Randevu Talep Listesi</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" style="background-color: transparent !important;">
                    <thead class="text-muted small text-uppercase" style="background-color: rgba(255, 255, 255, 0.02); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                        <tr>
                            <th class="py-3 px-4 text-muted">Veli / İletişim</th>
                            <th class="py-3 text-muted">Terapi / Eğitim</th>
                            <th class="py-3 text-muted">Yaş Aralığı</th>
                            <th class="py-3 text-muted">Talep Edilen Tarih / Saat</th>
                            <th class="py-3 text-muted">Durum</th>
                            <th class="py-3 text-end px-4 text-muted">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                    <td class="px-4">
                                        <div class="fw-bold text-white">@item.FullName</div>
                                        <div class="small text-muted"><i class="fa-solid fa-phone me-1 text-primary"></i>@item.Phone</div>
                                        @if (!string.IsNullOrEmpty(item.Email))
                                        {
                                            <div class="small text-muted"><i class="fa-solid fa-envelope me-1 text-muted"></i>@item.Email</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-25 text-info border border-info border-opacity-25 px-2 py-1 fw-semibold">
                                            <i class="fa-solid fa-graduation-cap me-1"></i>@item.ServiceType
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-light small fw-medium">@item.AgeRange</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-light small"><i class="fa-regular fa-calendar me-1 text-muted"></i>@item.AppointmentDate.ToString("dd.MM.yyyy")</div>
                                        <div class="text-muted small"><i class="fa-regular fa-clock me-1 text-muted"></i>@item.AppointmentTime</div>
                                    </td>
                                    <td>
                                        @if (item.Status == "Beklemede")
                                        {
                                            <span class="badge bg-warning bg-opacity-15 text-warning px-3 py-2 rounded-pill fw-bold small">Beklemede</span>
                                        }
                                        else if (item.Status == "Onaylandı")
                                        {
                                            <span class="badge bg-success bg-opacity-15 text-success px-3 py-2 rounded-pill fw-bold small">Onaylandı</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-15 text-danger px-3 py-2 rounded-pill fw-bold small">İptal edildi.</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <!-- Onayla Butonu & SweetAlert -->
                                            @if (item.Status != "Onaylandı")
                                            {
                                                <form id="approve-form-@item.Id" asp-action="Approve" asp-route-id="@item.Id" method="post" class="m-0">
                                                    <button type="button" onclick="confirmApprove(@item.Id)" class="btn btn-sm btn-success rounded-3 px-3 fw-semibold shadow-sm" title="Randevuyu Onayla">
                                                        <i class="fa-solid fa-check me-1"></i> Onayla
                                                    </button>
                                                </form>
                                            }

                                            <!-- İptal Et Butonu & SweetAlert -->
                                            @if (item.Status != "İptal edildi.")
                                            {
                                                <form id="cancel-form-@item.Id" asp-action="Cancel" asp-route-id="@item.Id" method="post" class="m-0">
                                                    <button type="button" onclick="confirmCancel(@item.Id)" class="btn btn-sm btn-outline-danger rounded-3 px-3 fw-semibold" title="Randevuyu İptal Et">
                                                        <i class="fa-solid fa-ban me-1"></i> İptal
                                                    </button>
                                                </form>
                                            }

                                            <!-- Sil Butonu & SweetAlert -->
                                            <form id="delete-form-@item.Id" asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0">
                                                <button type="button" onclick="confirmDelete(@item.Id)" class="btn btn-sm btn-dark text-danger border border-secondary border-opacity-50 rounded-3 px-2" title="Kaydı Sil">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                @if (!string.IsNullOrEmpty(item.Message))
                                {
                                    <tr style="background-color: rgba(255, 255, 255, 0.02) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                        <td colspan="6" class="px-4 py-2">
                                            <small class="text-muted fw-semibold">Veli Notu:</small>
                                            <small class="text-light italic d-block">"@item.Message"</small>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <i class="fa-regular fa-calendar-xmark fa-3x mb-3 text-secondary opacity-50"></i>
                                        <p class="mb-0 fw-semibold text-muted">Henüz sisteme düşmüş bir randevu talebi bulunmuyor.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmApprove(id) {
            Swal.fire({
                title: 'Randevuyu Onayla',
                text: "Bu randevu talebini onaylamak istediğinize emin misiniz?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10B981',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Evet, Onayla',
                cancelButtonText: 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('approve-form-' + id).submit();
                }
            });
        }

        function confirmCancel(id) {
            Swal.fire({
                title: 'Randevuyu İptal Et',
                text: "Bu randevuyu iptal etmek istediğinize emin misiniz?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Evet, İptal Et',
                cancelButtonText: 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('cancel-form-' + id).submit();
                }
            });
        }

        function confirmDelete(id) {
            Swal.fire({
                title: 'Kayıt Silinecek',
                text: "Bu randevu kaydını kalıcı olarak silmek istediğinize emin misiniz?",
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#DC2626',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Evet, Sil',
                cancelButtonText: 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('delete-form-' + id).submit();
                }
            });
        }
    </script>
}