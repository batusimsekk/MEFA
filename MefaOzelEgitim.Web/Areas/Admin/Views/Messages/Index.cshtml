@model IEnumerable<MefaOzelEgitim.Domain.Entities.ContactMessage>

@{
    ViewData["Title"] = "İletişim Mesajları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-white m-0">
            <i class="fa-solid fa-envelope me-2 text-primary"></i> İletişim Mesajları
        </h2>
        <span class="badge bg-primary fs-6 px-3 py-2">
            Toplam: @Model.Count()
        </span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Koyu tema uyumlu kart ve tablo yapısı -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-dark text-white" style="border: 1px solid rgba(255,255,255,0.1) !important;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-secondary text-dark text-uppercase fs-7">
                        <tr>
                            <th class="py-3 ps-4">Gönderen</th>
                            <th>E-posta / Telefon</th>
                            <th>Konu</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th class="text-end py-3 pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="@(item.IsRead ? "" : "fw-bold")" style="background-color: @(item.IsRead ? "transparent" : "rgba(13, 110, 253, 0.1)")">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-primary bg-opacity-25 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px; min-width: 35px;">
                                                <i class="fa-solid fa-user"></i>
                                            </div>
                                            <div>
                                                <span class="text-white d-block">@item.SenderName</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-light"><i class="fa-solid fa-envelope me-1 text-primary"></i> @item.Email</div>
                                        <div class="small text-light"><i class="fa-solid fa-phone me-1 text-primary"></i> @(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)</div>
                                    </td>
                                    <td>
                                        <span class="text-white text-truncate d-inline-block" style="max-width: 200px;">@item.Subject</span>
                                    </td>
                                    <td>
                                        <span class="small text-light">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</span>
                                    </td>
                                    <td>
                                        @if (item.IsRead)
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success px-2 py-1">Okundu</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger px-2 py-1">Okunmadı</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <!-- Eğer mesaj okunmadıysa "Okundu Yap" butonu göster -->
                                        @if (!item.IsRead)
                                        {
                                            <form asp-action="MarkAsRead" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-info rounded-pill px-3 me-1" title="Okundu Olarak İşaretle">
                                                    <i class="fa-solid fa-check me-1"></i> Okundu Yap
                                                </button>
                                            </form>
                                        }

                                        <!-- İncele Butonu -->
                                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 me-1" data-bs-toggle="modal" data-bs-target="#messageModal@(item.Id)">
                                            <i class="fa-solid fa-eye me-1"></i> İncele
                                        </button>

                                        <!-- Silme Formu -->
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Sil">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                <!-- Mesaj Detay Modalı (Koyu Tema) -->
                                <div class="modal fade" id="messageModal@(item.Id)" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-lg">
                                        <div class="modal-content bg-dark text-white border border-secondary rounded-4 shadow">
                                            <div class="modal-header border-bottom border-secondary pb-3">
                                                <h5 class="modal-title fw-bold text-white">Mesaj Detayı</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-4">
                                                <div class="row mb-3">
                                                    <div class="col-md-6">
                                                        <span class="text-muted small d-block">Gönderen Adı</span>
                                                        <span class="fw-semibold text-white">@item.SenderName</span>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <span class="text-muted small d-block">Tarih</span>
                                                        <span class="fw-semibold text-white">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</span>
                                                    </div>
                                                </div>
                                                <div class="row mb-3">
                                                    <div class="col-md-6">
                                                        <span class="text-muted small d-block">E-posta Adresi</span>
                                                        <span class="fw-semibold text-white">@item.Email</span>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <span class="text-muted small d-block">Telefon Numarası</span>
                                                        <span class="fw-semibold text-white">@(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)</span>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <span class="text-muted small d-block">Konu</span>
                                                    <span class="fw-semibold text-white">@item.Subject</span>
                                                </div>
                                                <div class="mb-3">
                                                    <span class="text-muted small d-block">Mesaj İçeriği</span>
                                                    <div class="p-3 bg-secondary bg-opacity-15 rounded-3 text-white mt-1 border border-secondary" style="white-space: pre-wrap;">@item.Message</div>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top border-secondary pt-3">
                                                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-inbox fs-1 mb-2 d-block text-secondary opacity-50"></i>
                                    Henüz gelen bir iletişim mesajı bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>