@model MefaOzelEgitim.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<section class="py-5 bg-light min-vh-100 d-flex align-items-center">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white position-relative overflow-hidden" data-aos="fade-up" style="border: 1px solid var(--border-color) !important;">
                    
                    <!-- Üst Dekoratif Renk Çizgisi (Maviden Turuncuya Geçiş) -->
                    <div class="position-absolute top-0 start-0 w-100" style="height: 5px; background: linear-gradient(135deg, var(--primary-blue) 0%, var(--sunset-orange) 100%);"></div>

                    <div class="text-center mb-4 pt-2">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm" style="width: 65px; height: 65px; background: linear-gradient(135deg, rgba(2, 132, 199, 0.1) 0%, rgba(249, 115, 22, 0.1) 100%); color: var(--primary-blue);">
                            <i class="fa-solid fa-right-to-bracket fs-4"></i>
                        </div>
                        <h2 class="fw-bold mb-1 text-dark">Hoş Geldiniz</h2>
                        <p class="text-muted small">Hesabınıza giriş yaparak devam edin</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2 mb-3"></div>

                        <!-- E-posta Alanı -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold small text-secondary">E-posta Adresi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted ps-3">
                                    <i class="fa-regular fa-envelope"></i>
                                </span>
                                <input asp-for="Email" class="form-control form-control-lg bg-light border-start-0 fs-6 rounded-end-3 py-2" placeholder="ornek@mail.com">
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Şifre Alanı ve Göz İkonu -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="Password" class="form-label fw-semibold small text-secondary mb-1">Şifre</label>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted ps-3">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                                <input asp-for="Password" type="password" id="passwordInput" class="form-control form-control-lg bg-light border-start-0 border-end-0 fs-6 py-2" placeholder="••••••••">
                                <button type="button" id="togglePassword" class="input-group-text bg-light border-start-0 rounded-end-3 text-muted px-3" style="cursor: pointer;" title="Şifreyi Göster/Gizle">
                                    <i class="fa-regular fa-eye" id="toggleIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Beni Hatırla -->
                        <div class="mb-4 form-check">
                            <input asp-for="RememberMe" class="form-check-input rounded-2" type="checkbox">
                            <label asp-for="RememberMe" class="form-check-label small text-secondary">Beni Hatırla</label>
                        </div>

                        <!-- Gradyant Giriş Butonu -->
                        <button type="submit" class="btn w-100 py-3 rounded-3 fw-bold text-white shadow-sm"
                                style="background: linear-gradient(135deg, #f97316 0%, #ea580c 100%) !important; border: none; transition: all 0.2s ease;">
                            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Giriş Yap
                        </button>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="small text-muted mb-0">Hesabınız yok mu? <a asp-action="Register" class="fw-semibold text-decoration-none" style="color: var(--primary-blue);">Kayıt Ol</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');

            if (togglePassword && passwordInput && toggleIcon) {
                togglePassword.addEventListener('click', function () {
                    // Şifre inputunun türünü password <-> text olarak değiştir
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);

                    // Göz ikonunu açıp kapatma (FontAwesome sınıfları)
                    toggleIcon.classList.toggle('fa-eye');
                    toggleIcon.classList.toggle('fa-eye-slash');
                });
            }
        });
    </script>
}